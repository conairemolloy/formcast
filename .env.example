# Copy to .env and fill in real values. Never commit .env (it is gitignored).
# The same names are used locally, on Railway, and as GitHub Actions secrets.

# football-data.org — fixtures/live scores (api/routes/live.py, scripts/ingest_football_data_org.py)
FDATA_API_KEY=

# The Odds API — bookmaker odds (scripts/fetch_live_odds.py, scripts/log_odds_snapshot.py)
ODDS_API_KEY=

# OpenWeather — weather for upcoming fixtures (scripts/fetch_weather.py; optional, skipped if blank)
OPENWEATHER_API_KEY=

# Supabase — auth + data upload (api/routes/auth.py, scripts/ingest_football_data.py, scripts/merge_football_data_org.py)
SUPABASE_URL=
SUPABASE_KEY=
# Service-role key: server-side only, never expose to the frontend
SUPABASE_SERVICE_KEY=

# Optional overrides
# PORT=5001
# FORMCAST_API_URL=https://<your-railway-app>/api/live/upcoming
# UPCOMING_DAYS=21
# SKIP_SUPABASE_UPLOAD=true

# Frontend (set in Vercel, or frontend/.env.local for dev)
# VITE_API_URL=https://<your-railway-app>
